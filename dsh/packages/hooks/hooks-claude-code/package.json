{
  "name": "@nuaagent/hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the NUAAgent interception seams",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/hooks/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nuaagent/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@nuaagent/agent": "workspace:^",
    "@nuaagent/hook-protocol": "workspace:^",
    "@nuaagent/invariants": "workspace:^",
    "@nuaagent/llm": "workspace:^",
    "@nuaagent/session": "workspace:^",
    "@nuaagent/session-persistence": "workspace:^",
    "@nuaagent/subagent": "workspace:^",
    "@nuaagent/tools": "workspace:^",
    "@nuaagent/cordis": "workspace:^"
  },
  "devDependencies": {
    "@nuaagent/agent": "workspace:^",
    "@nuaagent/agent-loop": "workspace:^",
    "@nuaagent/agent-loop-testkit": "workspace:^",
    "@nuaagent/shell": "workspace:^",
    "@nuaagent/bash-local": "workspace:^",
    "@nuaagent/subprocess-local": "workspace:^",
    "@nuaagent/hook-protocol": "workspace:^",
    "@nuaagent/invariants": "workspace:^",
    "@nuaagent/llm": "workspace:^",
    "@nuaagent/session": "workspace:^",
    "@nuaagent/session-persistence": "workspace:^",
    "@nuaagent/session-persistence-jsonl": "workspace:^",
    "@nuaagent/subagent": "workspace:^",
    "@nuaagent/tools": "workspace:^",
    "@nuaagent/cordis": "workspace:^"
  }
}
