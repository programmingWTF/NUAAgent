    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nuaagent/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
