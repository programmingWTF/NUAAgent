    "@nuaagent/brand": "workspace:^",
    "@nuaagent/invariants": "workspace:^",
    "@nuaagent/llm": "workspace:^",
    "@nuaagent/session": "workspace:^",
    "@nuaagent/session-persistence": "workspace:^",
    "@nuaagent/subagent": "workspace:^",
    "@nuaagent/cordis": "workspace:^"
  },
  "devDependencies": {
    "@nuaagent/agent": "workspace:^",
    "@nuaagent/agent-loop": "workspace:^",
    "@nuaagent/agent-loop-testkit": "workspace:^",
    "@nuaagent/brand": "workspace:^",
    "@nuaagent/invariants": "workspace:^",
    "@nuaagent/llm": "workspace:^",
    "@nuaagent/session": "workspace:^",
    "@nuaagent/session-persistence": "workspace:^",
    "@nuaagent/session-persistence-jsonl": "workspace:^",
    "@nuaagent/session-persistence-sqlite": "workspace:^",
    "@nuaagent/subagent": "workspace:^",
    "@nuaagent/subagent-fork-in-process": "workspace:^",
    "@nuaagent/subagent-spawn-in-process": "workspace:^",
    "@nuaagent/cordis": "workspace:^"
  }
