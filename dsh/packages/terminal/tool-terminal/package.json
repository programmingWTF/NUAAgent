{
  "name": "@nuaagent/tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nuaagent/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@nuaagent/agent": "workspace:^",
    "@nuaagent/invariants": "workspace:^",
    "@nuaagent/llm": "workspace:^",
    "@nuaagent/terminal": "workspace:^",
    "@nuaagent/output-retention": "workspace:^",
    "@nuaagent/system-prompt": "workspace:^",
    "@nuaagent/jobs": "workspace:^",
    "@nuaagent/tools": "workspace:^",
    "@nuaagent/cordis": "workspace:^"
  },
  "devDependencies": {
    "@nuaagent/cordis-plugin-include": "workspace:^",
    "@nuaagent/cordis-plugin-loader": "workspace:^",
    "@nuaagent/agent": "workspace:^",
    "@nuaagent/invariants": "workspace:^",
    "@nuaagent/llm": "workspace:^",
    "@nuaagent/terminal": "workspace:^",
    "@nuaagent/terminal-bash": "workspace:^",
    "@nuaagent/output-retention": "workspace:^",
    "@nuaagent/sandbox": "workspace:^",
    "@nuaagent/sandbox-policy": "workspace:^",
    "@nuaagent/session": "workspace:^",
    "@nuaagent/subprocess-local": "workspace:^",
    "@nuaagent/system-prompt": "workspace:^",
    "@nuaagent/jobs": "workspace:^",
    "@nuaagent/jobs-local": "workspace:^",
    "@nuaagent/tool-jobs": "workspace:^",
    "@nuaagent/tools": "workspace:^",
    "@nuaagent/cordis": "workspace:^"
  }
}
