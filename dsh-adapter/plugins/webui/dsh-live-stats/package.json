{
  "name": "@linxin666/dsh-live-stats",
  "version": "0.1.18",
  "description": "Live token estimates and generation throughput for DSH Web",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@nuaagent/client-runtime",
        "@nuaagent/client-connection",
        "@nuaagent/client-ui-conversation",
        "@nuaagent/client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "schemastery": "^3.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuaagent/cordis": "^4.0.1",
    "@nuaagent/attachment": "^0.1.0-rc.6",
    "@nuaagent/brand": "^0.1.0-rc.6",
    "@nuaagent/client-locale": "^0.1.0-rc.6",
    "@nuaagent/client-runtime": "^0.1.0-rc.6",
    "@nuaagent/client-ui-conversation": "^0.1.0-rc.6",
    "@nuaagent/client-ui-settings": "^0.1.0-rc.6",
    "@nuaagent/client-ui-slots": "^0.1.0-rc.6",
    "@nuaagent/invariants": "^0.1.0-rc.6",
    "@nuaagent/llm": "^0.1.0-rc.6",
    "@nuaagent/session": "^0.1.0-rc.6",
    "@nuaagent/scope": "^0.1.0-rc.6",
    "@nuaagent/settings": "^0.1.0-rc.6",
    "@nuaagent/timeout": "^0.1.0-rc.6",
    "@nuaagent/token-meter": "^0.1.0-rc.6",
    "@nuaagent/typert-protocol": "^0.1.0-rc.6",
    "@nuaagent/session-projection": "^0.1.0-rc.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web-ui.git"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "watch": "tsdown --watch"
  }
}